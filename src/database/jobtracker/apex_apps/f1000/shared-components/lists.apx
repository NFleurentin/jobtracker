list navigation-bar (
    name: Navigation Bar

    entry --- (
        label: ---
        layout {
            sequence: 20
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: separator
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

    entry app-user (
        label: &APP_USER.
        icon {
            imageIconCssClasses: fa-user
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                type: url
                url: #
            }
        }
        userDefinedAttributes {
            2: has-username
        }
    )

    entry sign-out (
        label: Se déconnecter
        icon {
            imageIconCssClasses: fa-sign-out
        }
        layout {
            sequence: 30
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: &LOGOUT_URL.
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

)

list navigation-menu (
    name: Navigation Menu

    entry candidatures (
        label: Candidatures
        icon {
            imageIconCssClasses: fa-paper-plane
        }
        layout {
            sequence: 50
        }
        isCurrent {
            type: pages
            pages: [
                300
                301
            ]
        }
        link {
            target: {
                page: 300
            }
        }
    )

    entry contacts (
        label: Contacts
        icon {
            imageIconCssClasses: fa-address-book
        }
        layout {
            sequence: 30
        }
        isCurrent {
            type: pages
            pages: [
                400
                401
            ]
        }
        link {
            target: {
                page: 400
            }
        }
    )

    entry entreprises (
        label: Entreprises
        icon {
            imageIconCssClasses: fa-building
        }
        layout {
            sequence: 20
        }
        isCurrent {
            type: pages
            pages: [
                100
                101
            ]
        }
        link {
            target: {
                page: 100
            }
        }
    )

    entry home (
        label: Accueil
        icon {
            imageIconCssClasses: fa-home
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 1
            }
        }
    )

    entry postes (
        label: Postes
        icon {
            imageIconCssClasses: fa-briefcase
        }
        layout {
            sequence: 40
        }
        isCurrent {
            type: pages
            pages: 9010
        }
        link {
            target: {
                page: 9010
            }
        }
    )

)

