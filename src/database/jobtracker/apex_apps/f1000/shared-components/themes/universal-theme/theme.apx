theme universal-theme (
    name: Universal Theme
    themeNumber: 42
    baseTheme: ut-26.1
    style {
        currentThemeStyle: @jobtracker
    }
    javaScript {
        fileUrls: [
            #APEX_FILES#libraries/apex/#MIN_DIRECTORY#widget.stickyWidget#MIN#.js?v=#APEX_VERSION#
            #THEME_FILES#js/theme42#MIN#.js?v=#APEX_VERSION#
        ]
    }
    css {
        fileUrls: #THEME_FILES#css/Core#MIN#.css?v=#APEX_VERSION#
    }
    componentDefaults {
        page: @/standard
        navigationBarList: @/navigation-bar
        navigationMenuListPosition: side
        navigationMenuListTop: @/top-navigation-menu
        navigationMenuListSide: @/side-navigation-menu
        loginPage: @/login
        errorPage: @/login
        printerFriendlyPage: @/standard
        breadcrumb: @/breadcrumb
        button: @/text
        defaultLabel: @/optional-floating
        optionalLabel: @/optional-floating
        requiredLabel: @/required-floating
        list: @/links-list
        region: @/standard
        classicReport: @/standard
    }
    regionDefaults {
        breadcrumbs: @/title-bar
        charts: @/standard
        forms: @/standard
        lists: @/standard
        reports: @/standard
        wizards: @/standard
        interactiveReports: @/interactive-report
    }
    dialogDefaults {
        dialogContentRegion: @/blank-with-attributes
        dialogButtonRegion: @/buttons-container
        dialogPage: @/modal-dialog
    }
    icons {
        library: fontApex
    }
    advanced {
        filePrefix: #APEX_FILES#themes/theme_42/26.1/
        identifier: UNIVERSAL_THEME
    }

    style jobtracker (
        name: JobTracker
        css {
            fileUrls: #APEX_FILES#libraries/oracle-fonts/oraclesans-apex#MIN#.css?v=#APEX_VERSION#
        }
        themeRollerAttributes {
            inputParameterFileUrls: #THEME_FILES#less/theme/Iris.less
            outputCssFileUrl: #THEME_DB_FILES#20814627429231067.css
            jsonConfig: "{\"classes\":[],\"vars\":{\"@g_Header_Style\":\"pillar\",\"@g_Nav_Style\":\"light\",\"@g_Accent-Pillar\":\"plum\",\"@g_FontFamily\":\"system\",\"@Head-Height\":\"48px\",\"@Nav-Exp\":\"15rem\",\"@Actions-Exp\":\"12.5rem\",\"@Side-Exp\":\"15rem\"},\"customCSS\":\"/* Zone de titre des pages : plus compacte que le défaut du Universal Theme.\\n   Surcharge volontairement limitée à cette zone (voir README, choix techniques). */\\n.t-Body-title .t-Breadcrumb-label {\\n  font-size: 1.25rem;\\n  line-height: 1.2;\\n}\\n\\n.t-Body-title .t-BreadcrumbRegion {\\n  padding-block: 0.5rem;\\n}\",\"useCustomLess\":\"N\"}"
        }
        advanced {
            endUserCanPick: true
            accessibilityTested: true
        }
    )

)

