page 301 (
    name: Candidature
    alias: CANDIDATURE
    title: Candidature
    pageGroup: @candidatures
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region application-status-changes (
        name: application-status-changes
        title: Historique des statuts
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: UI_APPLICATION_STATUS_CHANGES_LIST
            whereClause: application_id = :P301_APPLICATION_ID
            orderByClause: changed_at desc
        }
        layout {
            sequence: 20
            slot: contentBody
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P301_APPLICATION_ID
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function(config) {
                    config.defaultGridViewOptions = { footer: false };
                    return config;
                }
                ```
        }
        advanced {
            savedReportMappingIdentifier: 14603177717473624
        }

        savedReport primary (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @APPLICATION_STATUS_CHANGE_ID
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @APPLICATION_STATUS_ID
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @CHANGED_AT
                layout {
                    sequence: 6
                }
            )

            displayColumn (
                column: @NOTE_TEXT
                layout {
                    sequence: 7
                }
            )

            displayColumn (
                column: @IS_LATEST
                layout {
                    sequence: 8
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APPLICATION_STATUS_CHANGE_ID (
            type: hidden
            heading {
                heading: Application Status Change Id
            }
            layout {
                sequence: 30
            }
            source {
                databaseColumn: APPLICATION_STATUS_CHANGE_ID
                dataType: number
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column APPLICATION_STATUS_ID (
            type: selectList
            heading {
                heading: Statut
            }
            lov {
                type: sharedComponent
                lov: @application-statuses-lov
                nullDisplayValue: - Choisir -
            }
            layout {
                sequence: 50
            }
            accessibility {
                valueIdentifiesRow: true
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: APPLICATION_STATUS_ID
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
            readOnly {
                type: functionBody
                plsqlFunctionBody: return nvl(:IS_LATEST = false, false);
                execute: forEachRow
            }
        )

        column CHANGED_AT (
            type: datePicker
            heading {
                heading: Date
            }
            layout {
                sequence: 80
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: CHANGED_AT
                dataType: timestampWithLocalTimeZone
            }
            readOnly {
                type: functionBody
                plsqlFunctionBody: return nvl(:IS_LATEST = false, false);
                execute: forEachRow
            }
        )

        column IS_LATEST (
            type: hidden
            heading {
                heading: Is Latest
            }
            settings {
                valueProtected: false
            }
            layout {
                sequence: 100
            }
            source {
                databaseColumn: IS_LATEST
                dataType: boolean
            }
            sessionState {
                dataType: boolean
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column NOTE_TEXT (
            type: textarea
            heading {
