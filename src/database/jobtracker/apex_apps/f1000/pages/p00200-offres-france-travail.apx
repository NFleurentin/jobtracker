page 200 (
    name: Offres France Travail
    alias: OFFRES-FRANCE-TRAVAIL
    title: Offres France Travail
    pageGroup: @offres
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region alert_1 (
        name: no-search
        title: Aucune recherche
        type: staticContent
        source {
            htmlCode: Choisissez vos critères, puis lancez la recherche.
        }
        layout {
            sequence: 10
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/alert
            templateOptions: [
                #DEFAULT#
                t-Alert--horizontal
                t-Alert--defaultIcons
                t-Alert--info
                t-Alert--accessibleHeading
            ]
        }
        serverSideCondition {
            type: itemIsNull
            item: P200_STATUS
        }
    )

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region limit (
        name: capped-results
        title: Résultats plafonnés
        type: staticContent
        source {
            htmlCode: &P200_TOTAL_COUNT. offres trouvées, &P200_LOADED_COUNT. chargées par ordre de pertinence. Affinez les critères pour les voir toutes.
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/alert
            templateOptions: [
                #DEFAULT#
                t-Alert--horizontal
                t-Alert--defaultIcons
                t-Alert--warning
                t-Alert--accessibleHeading
            ]
        }
        serverSideCondition {
            type: item=value
            item: P200_STATUS
            value: CAPPED
        }
    )

    region offers (
        name: offers
        title: Offres
        type: interactiveReport
        source {
            location: localDatabase
            tableName: UI_FT_OFFER_SEARCH_RESULTS_LIST
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P200_STATUS
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: Aucune offre ne correspond à ces critères.
        }
        advanced {
            savedReportMappingIdentifier: 20015665048564804
        }

        column COMPANY_NAME (
            type: plainText
            heading {
                heading: Entreprise
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column CONTRACT_TYPE_NAME (
            type: plainText
            heading {
                heading: Contrat
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column EXTERNAL_ID (
            type: hidden
            heading {
                heading: Identifiant
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column SEARCH_RANK (
            type: plainText
            heading {
                heading: Ordre
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column TITLE (
            type: link
            heading {
                heading: Intitulé
            }
            layout {
                sequence: 30
            }
            accessibility {
                valueIdentifiesRow: true
            }
            link {
                target: {
                    page: 201
                    items: {
                        P201_EXTERNAL_ID: #EXTERNAL_ID#
                    }
                    clearCache: 201
                }
                linkText: #TITLE#
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column UPDATED_AT (
            type: plainText
            heading {
                heading: Mise à jour
            }
            layout {
                sequence: 40
            }
            source {
                dataType: DATE
                timezoneAware: Y
            }
            advanced {
                endUserAlias: D
            }
        )

        column WORKPLACE_NAME (
            type: plainText
            heading {
                heading: Lieu
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Offres
        }

        savedReport primary (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn COMPANY_NAME (
                sequence: 4
            )

            displayColumn CONTRACT_TYPE_NAME (
                sequence: 5
            )

            displayColumn TITLE (
                sequence: 1
            )

            displayColumn UPDATED_AT (
                sequence: 2
            )

            displayColumn WORKPLACE_NAME (
                sequence: 3
            )

            sort (
                column: SEARCH_RANK
                sort {
                    sequence: 1
                }
            )

        )

    )

    region partial (
        name: partial-result
        title: Résultat partiel
        type: staticContent
        source {
            htmlCode: Résultat partiel : &P200_LOADED_COUNT. offres chargées sur &P200_TOTAL_COUNT. trouvées. France Travail n'a pas répondu pour la suite ; relancez la recherche. Le détail est dans le journal des échanges.
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/alert
            templateOptions: [
                #DEFAULT#
                t-Alert--horizontal
                t-Alert--defaultIcons
                t-Alert--warning
                t-Alert--accessibleHeading
            ]
        }
        serverSideCondition {
            type: item=value
            item: P200_STATUS
            value: PARTIAL
        }
    )

    region search (
        name: search
        title: Recherche
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region search-advance (
        name: search-advance
        title: Avancé
        type: staticContent
        layout {
            sequence: 60
            parentRegion: @search
            slot: subRegions
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--scrollBody
            ]
        }
    )

    region search-contract (
        name: search-contract
        title: Contrat
        type: staticContent
        layout {
            sequence: 30
            parentRegion: @search
            slot: subRegions
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
                t-Region--scrollBody
            ]
        }
    )

    region search-period (
        name: search-period
        title: Période
        type: staticContent
        layout {
            sequence: 50
            parentRegion: @search
            slot: subRegions
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
                t-Region--scrollBody
            ]
        }
    )

    region search-salary (
        name: search-salary
        title: Salaire
        type: staticContent
        layout {
            sequence: 40
            parentRegion: @search
            slot: subRegions
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
                t-Region--scrollBody
            ]
        }
    )

    region search-what (
        name: search-what
        title: Quoi
        type: staticContent
        layout {
            sequence: 20
            parentRegion: @search
            slot: subRegions
            startNewRow: false
            columnSpan: 6
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
                t-Region--scrollBody
            ]
        }
    )

    region search-where (
        name: search-where
        title: Où
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @search
            slot: subRegions
            columnSpan: 6
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
                t-Region--scrollBody
            ]
        }
    )

    pageItem P200_COMMUNES (
        type: popupLov
        label {
            label: Communes
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select display_value, return_value
                  from ui_ft_communes_lov
                 order by display_value
                ```
            displayExtraValues: false
            nullDisplayValue: Toutes
        }
        multipleValues {
            type: delimitedList
        }
        layout {
            sequence: 10
            region: @search-where
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P200_CONTRACT_TYPES (
        type: checkboxGroup
        label {
            label: Types de contrat
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select display_value, return_value
                  from ui_ft_contract_types_lov
                 order by display_value
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 10
            region: @search-contract
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P200_COUNTRY (
        type: selectList
        label {
            label: Pays
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select display_value, return_value
                  from ui_ft_countries_lov
                 order by display_value
                ```
            displayExtraValues: false
            nullDisplayValue: Tous
        }
        layout {
            sequence: 60
            region: @search-where
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
    )

    pageItem P200_DEPARTMENTS (
        type: popupLov
        label {
            label: Départements
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select display_value, return_value
                  from ui_ft_departments_lov
                 order by display_value
                ```
            displayExtraValues: false
            nullDisplayValue: Tous
        }
        multipleValues {
            type: delimitedList
        }
        layout {
            sequence: 30
            region: @search-where
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P200_DISTANCE_KM (
        type: numberField
        label {
            label: Distance (km)
            alignment: left
        }
        settings {
            minValue: 0
        }
        layout {
            sequence: 20
            region: @search-where
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P200_EXPERIENCE (
        type: selectList
        label {
            label: Expérience
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select display_value, return_value
                  from ui_ft_experiences_lov
                 order by display_value
                ```
            displayExtraValues: false
            nullDisplayValue: Toutes
        }
        layout {
            sequence: 20
            region: @search-what
            slot: regionBody
