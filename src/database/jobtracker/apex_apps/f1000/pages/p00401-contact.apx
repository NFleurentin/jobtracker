page 401 (
    name: Contact
    alias: CONTACT
    title: Contact
    pageGroup: @contacts
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region contact (
        name: Contact
        type: form
        source {
            location: localDatabase
            tableName: UI_CONTACTS_FORM
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region positions (
        name: Postes
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: UI_CONTACT_POSITIONS_LIST
            whereClause: contact_id = :P401_CONTACT_ID
            pageItemsToSubmit: P401_CONTACT_ID
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: positions
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        pagination {
            showTotalCount: false
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function(config) {
                    config.defaultGridViewOptions = { footer: false };
                    return config;
                }
                
                ```
        }
        advanced {
            savedReportMappingIdentifier: 13801199579393302
        }

        savedReport primary (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @CONTACT_POSITION_ID
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @COMPANY_ID
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @JOB_ID
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @IS_CURRENT
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column COMPANY_ID (
            type: popupLov
            heading {
                heading: Entreprise
            }
            lov {
                type: sharedComponent
                lov: @companies-lov
                displayNullValue: false
            }
            layout {
                sequence: 50
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: COMPANY_ID
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column CONTACT_POSITION_ID (
            type: hidden
            heading {
                heading: Contact Position Id
            }
            layout {
                sequence: 30
            }
            source {
                databaseColumn: CONTACT_POSITION_ID
                dataType: number
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IS_CURRENT (
            type: switch
            heading {
                heading: Poste actuel
            }
            settings {
                useDefaults: false
                onLabel: Oui
                offLabel: Non
            }
            layout {
                sequence: 90
            }
            source {
                databaseColumn: IS_CURRENT
                dataType: boolean
            }
            sessionState {
                dataType: boolean
            }
        )

        column JOB_ID (
            type: popupLov
            heading {
                heading: Poste
            }
            lov {
                type: sharedComponent
                lov: @jobs-lov
                displayNullValue: false
            }
            layout {
                sequence: 70
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: JOB_ID
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

    )

    pageItem P401_CONTACT_ID (
        type: hidden
        layout {
            sequence: 20
            region: @contact
            slot: regionBody
        }
        source {
            formRegion: @contact
            column: CONTACT_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P401_CREATED_AT (
        type: displayOnly
        label {
            label: Créé le
            alignment: left
        }
        layout {
            sequence: 100
            region: @contact
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @contact
            column: CREATED_AT
            dataType: timestampWithLocalTimeZone
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P401_CONTACT_ID
        }
    )

    pageItem P401_EMAIL (
        type: textField
        label {
            label: Courriel
            alignment: left
        }
        settings {
            subtype: email
        }
        layout {
            sequence: 60
            region: @contact
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 254
        }
        source {
            formRegion: @contact
            column: EMAIL
            dataType: varchar2
        }
    )

    pageItem P401_FIRST_NAME (
        type: textField
        label {
            label: Prénom
            alignment: left
        }
        layout {
            sequence: 40
            region: @contact
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 100
        }
        source {
            formRegion: @contact
            column: FIRST_NAME
            dataType: varchar2
        }
    )

    pageItem P401_LAST_NAME (
        type: textField
        label {
            label: Nom
            alignment: left
        }
        layout {
            sequence: 50
            region: @contact
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 100
        }
        source {
            formRegion: @contact
            column: LAST_NAME
            dataType: varchar2
        }
    )

    pageItem P401_LINKEDIN_SLUG (
        type: textField
        label {
            label: Identifiant Linkedin
            alignment: left
        }
        layout {
            sequence: 80
            region: @contact
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 100
        }
        source {
            formRegion: @contact
            column: LINKEDIN_SLUG
            dataType: varchar2
        }
    )

    pageItem P401_NOTE_TEXT (
        type: textarea
        label {
            label: Notes
            alignment: left
        }
        layout {
            sequence: 90
            region: @contact
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        source {
            formRegion: @contact
            column: NOTE_TEXT
            dataType: clob
        }
        sessionState {
            dataType: clob
        }
    )

    pageItem P401_PHONE (
        type: textField
        label {
            label: Téléphone
            alignment: left
        }
        settings {
            subtype: phone
        }
        layout {
            sequence: 70
            region: @contact
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 30
        }
        source {
            formRegion: @contact
            column: PHONE
            dataType: varchar2
        }
    )

    pageItem P401_POSITION_COUNT (
        type: hidden
        layout {
            sequence: 120
            region: @contact
            slot: regionBody
        }
        source {
            formRegion: @contact
            column: POSITION_COUNT
            dataType: number
            queryOnly: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P401_SALUTATION_ID (
        type: selectList
        label {
            label: Civilité
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @salutations-lov
            nullDisplayValue: - Aucune -
        }
        layout {
            sequence: 30
            region: @contact
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            formRegion: @contact
            column: SALUTATION_ID
            dataType: number
        }
    )

    pageItem P401_UPDATED_AT (
        type: displayOnly
        label {
            label: Modifié le
            alignment: left
        }
        layout {
            sequence: 110
            region: @contact
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @contact
            column: UPDATED_AT
            dataType: timestampWithLocalTimeZone
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P401_CONTACT_ID
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Annuler
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
        }

        triggerAction native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
            }
        )

    )

    button create (
        buttonName: CREATE
        label: Créer
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P401_CONTACT_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Supprimer
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: item=value
            item: P401_POSITION_COUNT
            value: 0
        }
    )

    button delete-with-positions (
        buttonName: DELETE_WITH_POSITIONS
        label: Supprimer
        layout {
            sequence: 30
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$CONTACT_DELETE_WITH_POSITIONS_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNullAndNotZero
            item: P401_POSITION_COUNT
        }
    )

    button save (
        buttonName: SAVE
        label: Enregistrer
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P401_CONTACT_ID
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 7762105876717925
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE,DELETE_WITH_POSITIONS
        }
    )

    process initialize-form-contact (
        name: Initialize form Contact
        type: formInitialization
        formRegion: @contact
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 7761394745717922
        }
    )

    process positions-save-interactive-grid-data (
        name: Positions - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @positions
        target {
            targetType: plsqlCode
            dmlPlsqlCode:
                ```plsql
                case :APEX$ROW_STATUS
                    when 'C' then
                        :CONTACT_POSITION_ID := contact_api.create_position(
                            in_contact_id => :P401_CONTACT_ID,
                            in_company_id => :COMPANY_ID,
                            in_job_id     => :JOB_ID,
                            in_is_current => :IS_CURRENT
                        );
                    when 'U' then
                        contact_api.update_position(
                            in_contact_position_id => :CONTACT_POSITION_ID,
                            in_company_id          => :COMPANY_ID,
                            in_job_id              => :JOB_ID,
                            in_is_current          => :IS_CURRENT
                        );
                    when 'D' then
                        contact_api.delete_position(in_contact_position_id => :CONTACT_POSITION_ID);
                end case;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 13804198614393332
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
    )

    process process-form-contact (
        name: Process form Contact
        type: formAutoRowProcessing
        formRegion: @contact
        target {
            targetType: plsqlCode
            plsqlCode:
                ```plsql
                case :REQUEST
                    when 'CREATE' then
                        :P401_CONTACT_ID := contact_api.create_contact(
                            in_last_name     => :P401_LAST_NAME,
                            in_first_name    => :P401_FIRST_NAME,
                            in_salutation_id => :P401_SALUTATION_ID,
                            in_email         => :P401_EMAIL,
                            in_phone         => :P401_PHONE,
                            in_linkedin_slug => :P401_LINKEDIN_SLUG,
                            in_note_text     => :P401_NOTE_TEXT
                        );
                    when 'SAVE' then
                        contact_api.update_contact(
                            in_contact_id    => :P401_CONTACT_ID,
                            in_last_name     => :P401_LAST_NAME,
                            in_first_name    => :P401_FIRST_NAME,
                            in_salutation_id => :P401_SALUTATION_ID,
                            in_email         => :P401_EMAIL,
                            in_phone         => :P401_PHONE,
                            in_linkedin_slug => :P401_LINKEDIN_SLUG,
                            in_note_text     => :P401_NOTE_TEXT
                        );
                    when 'DELETE' then
                        contact_api.delete_contact(in_contact_id => :P401_CONTACT_ID);
                    when 'DELETE_WITH_POSITIONS' then
                        contact_api.delete_contact(in_contact_id => :P401_CONTACT_ID, in_delete_positions => true);
                end case;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 7761768597717924
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE,DELETE_WITH_POSITIONS
        }
    )

)

