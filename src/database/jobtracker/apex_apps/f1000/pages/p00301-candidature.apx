            type: itemIsNotNull
            item: P301_APPLICATION_ID
        }
    )

    process application-status-changes-save-interactive-grid-data (
        name: application-status-changes - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @application-status-changes
        target {
            targetType: plsqlCode
            dmlPlsqlCode:
                ```plsql
                case :APEX$ROW_STATUS
                    when 'C' then
                        :APPLICATION_STATUS_CHANGE_ID := application_api.add_status_change(
                            in_application_id        => :P301_APPLICATION_ID,
                            in_application_status_id => :APPLICATION_STATUS_ID,
                            in_changed_at            => :CHANGED_AT,
                            in_note_text             => :NOTE_TEXT
                        );
                    when 'U' then
                        if :IS_LATEST then
                            application_api.correct_latest_status_change(
                                in_application_status_change_id => :APPLICATION_STATUS_CHANGE_ID,
                                in_application_status_id        => :APPLICATION_STATUS_ID,
                                in_changed_at                   => :CHANGED_AT,
                                in_note_text                    => :NOTE_TEXT
                            );
                        else
                            application_api.update_status_note(
                                in_application_status_change_id => :APPLICATION_STATUS_CHANGE_ID,
                                in_note_text                    => :NOTE_TEXT
                            );
                        end if;
                    when 'D' then
                        application_api.delete_status_change(in_application_status_change_id => :APPLICATION_STATUS_CHANGE_ID);
                end case;
                ```
        }
        lockRow {
            preventLostUpdates: false
            lockRow: false
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 16207304217161904
        }
        serverSideCondition {
            type: request=Value
            value: SAVE
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 16056717500623544
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-candidature (
        name: Initialize form Candidature
        type: formInitialization
        formRegion: @candidature
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 16054648196623537
        }
    )

    process process-form-candidature (
        name: Process form Candidature
        type: formAutoRowProcessing
        formRegion: @candidature
        target {
            targetType: plsqlCode
            plsqlCode:
                ```plsql
                case :REQUEST
                    when 'CREATE' then
                        :P301_APPLICATION_ID := application_api.create_application(
                            in_company_id                   => :P301_COMPANY_ID,
                            in_application_type_id          => :P301_APPLICATION_TYPE_ID,
                            in_job_title                    => :P301_JOB_TITLE,
                            in_application_status_id        => :P301_APPLICATION_STATUS_ID,
                            in_changed_at                   => :P301_STATUS_CHANGED_AT,
                            in_annual_salary_proposed_euros => :P301_ANN_SALARY_PROPOSED_EUROS,
                            in_daily_rate_proposed_euros    => :P301_DAILY_RATE_PROPOSED_EUROS,
                            in_interest_rating              => :P301_INTEREST_RATING,
                            in_note_text                    => :P301_NOTE_TEXT
                        );
                    when 'SAVE' then
                        application_api.update_application(
                            in_application_id               => :P301_APPLICATION_ID,
                            in_company_id                   => :P301_COMPANY_ID,
                            in_application_type_id          => :P301_APPLICATION_TYPE_ID,
                            in_job_title                    => :P301_JOB_TITLE,
                            in_annual_salary_proposed_euros => :P301_ANN_SALARY_PROPOSED_EUROS,
                            in_daily_rate_proposed_euros    => :P301_DAILY_RATE_PROPOSED_EUROS,
                            in_interest_rating              => :P301_INTEREST_RATING,
                            in_note_text                    => :P301_NOTE_TEXT
                        );
                    when 'DELETE' then
                        application_api.delete_application(in_application_id => :P301_APPLICATION_ID);
                end case;
                ```
        }
        lockRow {
            lockRow: false
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 16055041045623537
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

)

