page 401 (
    name: Contact
    alias: CONTACT
    title: Contact
    pageGroup: @contacts
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region contact (
        name: Contact
        type: form
        source {
            location: localDatabase
            tableName: UI_CONTACTS_FORM
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P401_CONTACT_ID (
        type: hidden
        layout {
            sequence: 20
            region: @contact
            slot: regionBody
        }
        source {
            formRegion: @contact
            column: CONTACT_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P401_CREATED_AT (
        type: displayOnly
        label {
            label: Créé le
            alignment: left
        }
        layout {
            sequence: 100
            region: @contact
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @contact
            column: CREATED_AT
            dataType: timestampWithLocalTimeZone
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P401_CONTACT_ID
        }
    )

    pageItem P401_EMAIL (
        type: textField
        label {
            label: Courriel
            alignment: left
        }
        settings {
            subtype: email
        }
        layout {
            sequence: 60
            region: @contact
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 254
        }
        source {
            formRegion: @contact
            column: EMAIL
            dataType: varchar2
        }
    )

    pageItem P401_FIRST_NAME (
        type: textField
        label {
            label: Prénom
            alignment: left
        }
        layout {
            sequence: 40
            region: @contact
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 100
        }
        source {
            formRegion: @contact
            column: FIRST_NAME
            dataType: varchar2
        }
    )

    pageItem P401_LAST_NAME (
        type: textField
        label {
            label: Nom
            alignment: left
        }
        layout {
            sequence: 50
            region: @contact
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 100
        }
        source {
            formRegion: @contact
            column: LAST_NAME
            dataType: varchar2
        }
    )

    pageItem P401_LINKEDIN_SLUG (
        type: textField
        label {
            label: Identifiant Linkedin
            alignment: left
        }
        layout {
            sequence: 80
            region: @contact
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 100
        }
        source {
            formRegion: @contact
            column: LINKEDIN_SLUG
            dataType: varchar2
        }
    )

    pageItem P401_NOTE_TEXT (
        type: textarea
        label {
            label: Notes
            alignment: left
        }
        layout {
            sequence: 90
            region: @contact
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        source {
            formRegion: @contact
            column: NOTE_TEXT
            dataType: clob
        }
        sessionState {
            dataType: clob
        }
    )

    pageItem P401_PHONE (
        type: textField
        label {
            label: Téléphone
            alignment: left
        }
        settings {
            subtype: phone
        }
        layout {
            sequence: 70
            region: @contact
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 30
        }
        source {
            formRegion: @contact
            column: PHONE
            dataType: varchar2
        }
    )

    pageItem P401_SALUTATION_ID (
        type: selectList
        label {
            label: Civilité
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @salutations-lov
            nullDisplayValue: - Aucune -
        }
        layout {
            sequence: 30
            region: @contact
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            formRegion: @contact
            column: SALUTATION_ID
            dataType: number
        }
    )

    pageItem P401_UPDATED_AT (
        type: displayOnly
        label {
            label: Modifié le
            alignment: left
        }
        layout {
            sequence: 110
            region: @contact
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @contact
            column: UPDATED_AT
            dataType: timestampWithLocalTimeZone
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P401_CONTACT_ID
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Annuler
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
        }

        triggerAction native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
            }
        )

    )

    button create (
        buttonName: CREATE
        label: Créer
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P401_CONTACT_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Supprimer
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P401_CONTACT_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Enregistrer
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P401_CONTACT_ID
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 7762105876717925
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-contact (
        name: Initialize form Contact
        type: formInitialization
        formRegion: @contact
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 7761394745717922
        }
    )

    process process-form-contact (
        name: Process form Contact
        type: formAutoRowProcessing
        formRegion: @contact
        target {
            targetType: plsqlCode
            plsqlCode:
                ```plsql
                case :REQUEST
                    when 'CREATE' then
                        :P401_CONTACT_ID := contact_api.create_contact(
                            in_last_name     => :P401_LAST_NAME,
                            in_first_name    => :P401_FIRST_NAME,
                            in_salutation_id => :P401_SALUTATION_ID,
                            in_email         => :P401_EMAIL,
                            in_phone         => :P401_PHONE,
                            in_linkedin_slug => :P401_LINKEDIN_SLUG,
                            in_note_text     => :P401_NOTE_TEXT
                        );
                    when 'SAVE' then
                        contact_api.update_contact(
                            in_contact_id    => :P401_CONTACT_ID,
                            in_last_name     => :P401_LAST_NAME,
                            in_first_name    => :P401_FIRST_NAME,
                            in_salutation_id => :P401_SALUTATION_ID,
                            in_email         => :P401_EMAIL,
                            in_phone         => :P401_PHONE,
                            in_linkedin_slug => :P401_LINKEDIN_SLUG,
                            in_note_text     => :P401_NOTE_TEXT
                        );
                    when 'DELETE' then
                        contact_api.delete_contact(in_contact_id => :P401_CONTACT_ID);
                end case;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 7761768597717924
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

)

