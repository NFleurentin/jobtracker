# =============================================================================
# versions.env : versions figées des outils, partagées par le dev et la CI
# Toute montée de version passe par un commit.
#
# Format : KEY=value, valeurs littérales (ni $, ni guillemets, ni espace),
# commentaires sur des lignes entières. Lisible par `source` (Bash), par
# --env-file (Podman) et par $GITHUB_ENV après filtrage des commentaires.
# Une version se répète dans l'URL qui la contient : les changer ensemble.
# =============================================================================

# APEX du dev <= APEX de la prod (Autonomous Database met APEX à jour seule),
# sinon un export du dev ne s'importe pas en prod.
DB_IMAGE=container-registry.oracle.com/database/free:23.26.3.0
ORDS_IMAGE=container-registry.oracle.com/database/ords:26.3.0
APEX_VERSION=26.1
APEX_URL=https://download.oracle.com/otn_software/apex/apex_26.1.zip

# Logger ne publie pas d'empreinte : celle-ci a été relevée au premier téléchargement.
LOGGER_VERSION=3.1.1
LOGGER_URL=https://raw.githubusercontent.com/OraOpenSource/Logger/3.1.1/releases/logger_3.1.1.zip
LOGGER_SHA256=8a83fa29a23ad7a038a46a4b0071523044d115dfc801ce5b55ac09deeb214969

# Empreinte publiée par GitHub pour l'archive de la release (tag v.3.2.3)
UTPLSQL_VERSION=3.2.3
UTPLSQL_URL=https://github.com/utPLSQL/utPLSQL/releases/download/v.3.2.3/utPLSQL.zip
UTPLSQL_SHA256=6e650fc497bce02ae611e185e66c72204f0b984a024a41733b5452e7fb6db47a

# Client de migration (Java 17 ou plus). Oracle ne publie pas d'empreinte :
# celle-ci a été relevée au premier téléchargement.
SQLCL_VERSION=26.3.0.260.1620
SQLCL_URL=https://download.oracle.com/otn_software/java/sqldeveloper/sqlcl-26.3.0.260.1620.zip
SQLCL_SHA256=eb0dca2becc30e9aa1c700ae71e5df6efde8a33d098d7d23405b6558bbb81a81
