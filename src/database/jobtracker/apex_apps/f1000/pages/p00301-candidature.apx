            }
            layout {
                sequence: 90
            }
            source {
                databaseColumn: NOTE_TEXT
                dataType: clob
            }
            sessionState {
                dataType: clob
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
