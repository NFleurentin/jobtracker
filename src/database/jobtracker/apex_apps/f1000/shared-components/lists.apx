list navigation-bar (
    name: Navigation Bar

    entry --- (
        label: ---
        layout {
            sequence: 20
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: separator
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

    entry app-user (
        label: &APP_USER.
        icon {
            imageIconCssClasses: fa-user
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                type: url
                url: #
            }
        }
        userDefinedAttributes {
            2: has-username
        }
    )

    entry paramètres (
        label: Paramètres
        icon {
            imageIconCssClasses: fa-gear
        }
        layout {
            sequence: 5
        }
        isCurrent {
            type: pages
            pages: [
                9000
                9010
                9020
                9021
                9030
                9040
            ]
        }
        link {
            target: {
                page: 9000
            }
        }
        userDefinedAttributes {
            2: icon-only
            4: Paramètres
        }
    )

    entry sign-out (
        label: Se déconnecter
        icon {
            imageIconCssClasses: fa-sign-out
        }
        layout {
            sequence: 30
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: &LOGOUT_URL.
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

)

list navigation-menu (
    name: Navigation Menu

    entry candidatures (
        label: Candidatures
        icon {
            imageIconCssClasses: fa-paper-plane
        }
        layout {
            sequence: 40
        }
        isCurrent {
            type: pages
            pages: [
                300
                301
            ]
        }
        link {
            target: {
                page: 300
            }
        }
    )

    entry contacts (
        label: Contacts
        icon {
            imageIconCssClasses: fa-address-book
        }
        layout {
            sequence: 30
        }
        isCurrent {
            type: pages
            pages: [
                400
                401
            ]
        }
        link {
            target: {
                page: 400
            }
        }
    )

    entry entreprises (
        label: Entreprises
        icon {
            imageIconCssClasses: fa-building
        }
        layout {
            sequence: 20
        }
        isCurrent {
            type: pages
            pages: [
                100
                101
            ]
        }
        link {
            target: {
                page: 100
            }
        }
    )

    entry home (
        label: Accueil
        icon {
            imageIconCssClasses: fa-home
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 1
            }
        }
    )

)

list settings (
    name: Settings

    entry postes (
        label: Postes
        icon {
            imageIconCssClasses: fa-briefcase
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 9010
            }
        }
        userDefinedAttributes {
            1: Référentiel des intitulés de poste utilisés par les candidatures.
        }
    )

    entry référentiels-france-travail (
        label: Référentiels France Travail
        icon {
            imageIconCssClasses: fa-database
        }
        layout {
            sequence: 40
        }
        link {
            target: {
                page: 9040
            }
        }
        userDefinedAttributes {
            1: Recharger depuis l'API les codes des filtres de recherche.
        }
    )

    entry systèmes-externes (
        label: Systèmes externes
        icon {
            imageIconCssClasses: fa-server
        }
        layout {
            sequence: 30
        }
        link {
            target: {
                page: 9030
            }
        }
        userDefinedAttributes {
            1: Activer ou désactiver la journalisation des échanges, par système.
        }
    )

    entry échanges-externes (
        label: Échanges externes
        icon {
            imageIconCssClasses: fa-exchange
        }
        layout {
            sequence: 20
        }
        link {
            target: {
                page: 9020
            }
        }
        userDefinedAttributes {
            1: Journal des appels aux API externes : requêtes, réponses et erreurs.
        }
    )

)

