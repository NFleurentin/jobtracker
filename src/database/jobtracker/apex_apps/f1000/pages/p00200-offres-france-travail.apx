        settings {
            minValue: 0
        }
        layout {
            sequence: 10
            region: @search-salary
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P200_OFFER_ORIGIN (
        type: selectList
        label {
            label: Origine
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select display_value, return_value
                  from ui_ft_offer_origins_lov
                 order by display_value
                ```
            displayExtraValues: false
            nullDisplayValue: Toutes
        }
        layout {
            sequence: 30
            region: @search-advance
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
    )

    pageItem P200_POSTING_PERIOD (
        type: selectList
        label {
            label: Publiée depuis
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select display_value, return_value
                  from ui_ft_posting_periods_lov
                 order by display_order
                ```
            displayExtraValues: false
            nullDisplayValue: Tous
        }
        layout {
            sequence: 10
            region: @search-period
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
    )

    pageItem P200_REGION (
        type: selectList
        label {
            label: Région
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select display_value, return_value
                  from ui_ft_regions_lov
                 order by display_value
                ```
            displayExtraValues: false
            nullDisplayValue: Toutes
        }
        layout {
            sequence: 50
            region: @search-where
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
    )

    pageItem P200_SALARY_PERIOD (
        type: selectList
        label {
            label: Période
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select display_value, return_value
                  from ui_ft_salary_periods_lov
                 order by display_value
                ```
            displayExtraValues: false
            nullDisplayValue: Toutes
        }
        layout {
            sequence: 20
            region: @search-salary
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
    )

    pageItem P200_STATUS (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @search
            slot: regionBody
        }
    )

    pageItem P200_TOTAL_COUNT (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @search
            slot: regionBody
        }
    )

    button search (
        buttonName: SEARCH
        label: Rechercher
        layout {
            sequence: 10
            region: @search
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-search
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process rechercher-les-offres (
        name: Rechercher les offres
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                ft_offer_search.search(
                    in_keywords                    => :P200_KEYWORDS,
                    in_commune_codes               => :P200_COMMUNES,
                    in_distance_km                 => :P200_DISTANCE_KM,
                    in_department_codes            => :P200_DEPARTMENTS,
                    in_include_bordering           => :P200_INCLUDE_BORDERING,
                    in_region_code                 => :P200_REGION,
                    in_country_code                => :P200_COUNTRY,
                    in_contract_type_codes         => :P200_CONTRACT_TYPES,
                    in_experience_code             => :P200_EXPERIENCE,
                    in_experience_requirement_code => :P200_EXPERIENCE_REQUIREMENT,
                    in_min_salary                  => :P200_MIN_SALARY,
                    in_salary_period_code          => :P200_SALARY_PERIOD,
                    in_posting_period_code         => :P200_POSTING_PERIOD,
                    in_is_lacking_candidates       => :P200_IS_LACKING_CANDIDATES,
                    in_offer_origin_code           => :P200_OFFER_ORIGIN,
                    out_total_count                => :P200_TOTAL_COUNT,
                    out_loaded_count               => :P200_LOADED_COUNT,
                    out_status                     => :P200_STATUS,
                    out_failure_reason             => :P200_FAILURE_REASON
                );
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 20015343888564801
        }
        serverSideCondition {
            whenButtonPressed: @search
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 200
                action: resetPagination
            }
        }
    )

)

