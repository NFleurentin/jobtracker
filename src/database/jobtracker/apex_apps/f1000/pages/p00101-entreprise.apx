        }
        layout {
            sequence: 80
            region: @entreprise
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            formRegion: @entreprise
            column: COMPANY_SIZE_ID
            dataType: number
