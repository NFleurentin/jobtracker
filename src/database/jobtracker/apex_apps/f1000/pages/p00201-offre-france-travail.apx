page 201 (
    name: Offre France Travail
    alias: OFFRE-FRANCE-TRAVAIL
    title: Détail d'une offre
    pageGroup: @offres
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 1000
        chained: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region company (
        name: Company
        title: Entreprise
        type: staticContent
        layout {
            sequence: 50
            parentRegion: @détail-d-une-offre
            slot: subRegions
            startNewRow: false
            columnSpan: 6
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--scrollBody
            ]
        }
    )

    region conditions-and-benefits (
        name: Conditions and benefits
        title: Conditions et avantages
        type: classicReport
        source {
            location: localDatabase
            tableName: UI_FT_OFFER_SEARCH_CONTEXT_LIST
            whereClause: external_id = :P201_EXTERNAL_ID
        }
        orderBy {
            type: staticValue
            orderByClause: item_type, item_position
        }
        layout {
            sequence: 10
            parentRegion: @contract-and-terms
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        messages {
            whenNoDataFound: Aucune
        }

        column EXTERNAL_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 10
            }
        )

        column ITEM_DESCRIPTION (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Précision
            }
            layout {
                sequence: 50
            }
            sorting {
                sortable: false
            }
        )

        column ITEM_NAME (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Élément
            }
            layout {
                sequence: 40
            }
            accessibility {
                valueIdentifiesRow: true
            }
            sorting {
                sortable: false
            }
        )

        column ITEM_POSITION (
            reportColumnQueryId: 3
            derivedColumn: N
            type: hidden
            layout {
                sequence: 30
            }
        )

        column ITEM_TYPE (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 20
            }
        )

    )

