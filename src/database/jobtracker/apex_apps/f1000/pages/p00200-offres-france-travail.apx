        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
    )

    pageItem P200_FAILURE_REASON (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @search
            slot: regionBody
        }
    )

    pageItem P200_INCLUDE_BORDERING (
        type: switch
        label {
            label: Inclure les départements limitrophes
            alignment: left
        }
        layout {
            sequence: 40
            region: @search-where
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        sessionState {
            dataType: boolean
        }
    )

    pageItem P200_IS_LACKING_CANDIDATES (
        type: selectList
        label {
            label: Offres manquant de candidats
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @boolean
            displayExtraValues: false
            nullDisplayValue: Indifférent
        }
        layout {
            sequence: 20
            region: @search-advance
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
    )

    pageItem P200_KEYWORDS (
        type: textField
        label {
            label: Mots-clés
            alignment: left
        }
        layout {
            sequence: 10
            region: @search-what
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        help {
            helpText: Mots-clés séparés par des virgules, tous exigés
        }
    )

    pageItem P200_LOADED_COUNT (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @search
            slot: regionBody
        }
    )

    pageItem P200_MIN_SALARY (
        type: numberField
        label {
            label: Salaire (min)
            alignment: left
