page 9021 (
    name: Détail d'un échange
    alias: DETAIL-D-UN-ECHANGE
    title: Détail d'un échange
    pageGroup: @administration
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 1000
        chained: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region contexte-de-session (
        name: Contexte de session
        type: staticContent
        layout {
            sequence: 240
            parentRegion: @détail-d-un-échange
            slot: regionBody
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--scrollBody
            ]
        }
    )

    region corps (
        name: Corps
        type: staticContent
        layout {
            sequence: 20
            slot: contentBody
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region détail-d-un-échange (
        name: Échange
        type: form
        source {
            location: localDatabase
            tableName: UI_EXTERNAL_EXCHANGES_DETAIL
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region en-têtes-de-la-requête (
        name: En-têtes de la requête
        type: classicReport
        source {
            location: localDatabase
            tableName: UI_EXCHANGE_REQUEST_HEADERS_LIST
            whereClause: external_exchange_id = :P9021_EXTERNAL_EXCHANGE_ID
        }
        orderBy {
            type: staticValue
            orderByClause: field_position
        }
        layout {
            sequence: 40
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: item=value
            item: P9021_EXCHANGE_PROTOCOL_CODE
            value: HTTP
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        messages {
            whenNoDataFound: Aucun
        }

        column EXTERNAL_EXCHANGE_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 10
            }
        )

        column FIELD_NAME (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Nom
            }
            layout {
                sequence: 30
            }
            accessibility {
                valueIdentifiesRow: true
            }
            sorting {
                sortable: false
            }
        )

        column FIELD_POSITION (
            reportColumnQueryId: 2
            derivedColumn: N
