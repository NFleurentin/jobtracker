page 101 (
    name: Entreprise
    alias: ENTREPRISE
    title: Entreprise
    pageGroup: @companies
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region entreprise (
        name: Entreprise
        type: form
        source {
            location: localDatabase
            tableName: UI_COMPANIES_FORM
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P101_COMPANY_ID (
        type: hidden
        layout {
            sequence: 10
            region: @entreprise
            slot: regionBody
        }
        source {
            formRegion: @entreprise
            column: COMPANY_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P101_COMPANY_NAME (
        type: textField
        label {
            label: Nom
            alignment: left
        }
        layout {
            sequence: 20
            region: @entreprise
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 200
        }
        source {
            formRegion: @entreprise
            column: COMPANY_NAME
            dataType: varchar2
        }
    )

    pageItem P101_COMPANY_SIZE_ID (
        type: selectList
        label {
            label: Taille
            alignment: left
