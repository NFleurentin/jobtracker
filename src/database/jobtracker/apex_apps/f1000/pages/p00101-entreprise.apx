    button cancel (
        buttonName: CANCEL
        label: Annuler
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
        }

        triggerAction native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
            }
        )

    )

    button create (
        buttonName: CREATE
        label: Créer
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P101_COMPANY_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Supprimer
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P101_COMPANY_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Enregistrer
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P101_COMPANY_ID
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 12219140419864027
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-entreprise (
        name: Initialize form Entreprise
        type: formInitialization
        formRegion: @entreprise
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 12218336986864026
        }
    )

    process process-form-entreprise (
        name: Process form Entreprise
        type: formAutoRowProcessing
        formRegion: @entreprise
        target {
            targetType: plsqlCode
            plsqlCode:
                ```plsql
                case :REQUEST
                    when 'CREATE' then
                        :P101_COMPANY_ID := company_api.create_company(
                            in_company_name      => :P101_COMPANY_NAME,
                            in_description       => :P101_DESCRIPTION,
                            in_note_text         => :P101_NOTE_TEXT,
                            in_parent_company_id => :P101_PARENT_COMPANY_ID,
                            in_company_type_id   => :P101_COMPANY_TYPE_ID,
                            in_sector_id         => :P101_SECTOR_ID,
                            in_company_size_id   => :P101_COMPANY_SIZE_ID,
                            in_location_id       => :P101_LOCATION_ID,
                            in_siren             => :P101_SIREN,
                            in_website_url       => :P101_WEBSITE_URL,
                            in_linkedin_slug     => :P101_LINKEDIN_SLUG,
                            in_email             => :P101_EMAIL,
                            in_phone             => :P101_PHONE,
                            in_creation_year     => :P101_CREATION_YEAR
                        );
                    when 'SAVE' then
                        company_api.update_company(
                            in_company_id        => :P101_COMPANY_ID,
                            in_company_name      => :P101_COMPANY_NAME,
                            in_description       => :P101_DESCRIPTION,
                            in_note_text         => :P101_NOTE_TEXT,
                            in_parent_company_id => :P101_PARENT_COMPANY_ID,
                            in_company_type_id   => :P101_COMPANY_TYPE_ID,
                            in_sector_id         => :P101_SECTOR_ID,
                            in_company_size_id   => :P101_COMPANY_SIZE_ID,
                            in_location_id       => :P101_LOCATION_ID,
                            in_siren             => :P101_SIREN,
                            in_website_url       => :P101_WEBSITE_URL,
                            in_linkedin_slug     => :P101_LINKEDIN_SLUG,
                            in_email             => :P101_EMAIL,
                            in_phone             => :P101_PHONE,
                            in_creation_year     => :P101_CREATION_YEAR
                        );
                    when 'DELETE' then
                        company_api.delete_company(in_company_id => :P101_COMPANY_ID);
                end case;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 12218708193864026
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

)

